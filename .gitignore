# ---- Go build output ----
# `go build .` inside a service dir produces a binary named after that dir.
/services/api/api
/services/worker/worker
*.exe
*.dll
*.so
*.dylib

# ---- Go test / coverage ----
*.test
*.out
coverage.out
coverage.html

# ---- Vendoring (not used; enable if you `go mod vendor`) ----
# vendor/

# ---- CI/build evidence artifacts (generated by the pipeline; never commit) ----
sbom*.json
lint-*.json
test-*.json
scan-*.json
build-results-*.json

# ---- OS / editors ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
